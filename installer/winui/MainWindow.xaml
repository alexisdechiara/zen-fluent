<?xml version="1.0" encoding="utf-8"?>
<!-- Zen Fluent setup: one page on Mica, the title bar drawn into the window.
     Choices are option cards, as in Zen's own welcome screens (a radio,
     a title and its lines, an illustration; the chosen card outlined in
     the accent): the Zen version, then its profile in a select, then Zen
     Fluent or Zen Fluent Enhanced. The cards are built in code
     (MainWindow.xaml.cs). The actions sit in a footer. -->
<Window
    x:Class="ZenFluentSetup.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Padding="16,0,140,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE790;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="760" Padding="32,4,32,24" Spacing="8">
                <TextBlock Text="Zen Fluent" Style="{StaticResource TitleLargeTextBlockStyle}" />
                <TextBlock x:Name="LeadText" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" />

                <!-- Zen version: a card each, then the profile -->
                <Grid Margin="0,8,0,0">
                    <TextBlock x:Name="EditionHeader" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <HyperlinkButton x:Name="BrowseButton" HorizontalAlignment="Right" Click="BrowseButton_Click" />
                </Grid>
                <Grid x:Name="EditionCards" ColumnSpacing="12" RowSpacing="12" />
                <ComboBox x:Name="ProfileBox" HorizontalAlignment="Stretch" Margin="0,4,0,0" SelectionChanged="ProfileBox_SelectionChanged" />

                <!-- What to install: Zen Fluent or Zen Fluent Enhanced -->
                <StackPanel x:Name="InstallPanel" Spacing="8">
                <TextBlock x:Name="ComponentsHeader" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,20,0,0" />
                <Grid x:Name="ComponentCards" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>

                <!-- Scripts outside Sine's store: Zen Fluent Enhanced only -->
                <Border x:Name="ConsentBorder" CornerRadius="8" BorderThickness="1" Padding="16,12" Margin="0,4,0,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="4">
                        <CheckBox x:Name="ConsentCheck" Checked="ConsentCheck_Changed" Unchecked="ConsentCheck_Changed">
                            <TextBlock x:Name="ConsentText" TextWrapping="Wrap" />
                        </CheckBox>
                        <StackPanel x:Name="ConsentError" Orientation="Horizontal" Spacing="8" Visibility="Collapsed" Margin="28,0,0,0">
                            <FontIcon Glyph="&#xEA39;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <TextBlock x:Name="ConsentErrorText" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Sine: installed with the mods, or kept -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,4,0,0">
                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="SineText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                </StackPanel>

                <!-- Uninstall: what to remove from the chosen profile -->
                <StackPanel x:Name="UninstallPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="UninstallHeader" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,20,0,0" />
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel Spacing="4">
                            <CheckBox x:Name="RemoveModsCheck" IsEnabled="False" />
                            <CheckBox x:Name="RemoveSettingsCheck" />
                            <CheckBox x:Name="RemoveSineCheck" Checked="RemoveSineCheck_Changed" Unchecked="RemoveSineCheck_Changed" />
                            <InfoBar x:Name="RemoveSineWarning" Severity="Warning" IsClosable="False" IsOpen="False" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <InfoBar x:Name="ResultBar" IsClosable="True" IsOpen="False" Margin="0,12,0,0" />
                <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" />

                <Expander x:Name="DetailsExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <TextBlock x:Name="LogText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                </Expander>

                <TextBlock x:Name="SourceText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid Padding="24,16">
                <HyperlinkButton x:Name="ModeButton" HorizontalAlignment="Left" Click="ModeButton_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Name="CloseButton" MinWidth="120" Click="CloseButton_Click" />
                    <Button x:Name="InstallButton" MinWidth="120" Style="{StaticResource AccentButtonStyle}" Click="InstallButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
