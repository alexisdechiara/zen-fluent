    "options": [
      { "label": "1 hour", "value": "1" },
      { "label": "3 hours", "value": "3" },
      { "label": "6 hours", "value": "6" },
      { "label": "12 hours", "value": "12" },
      { "label": "1 day", "value": "24" },
      { "label": "2 days", "value": "48" },
      { "label": "1 week", "value": "168" }
    ]
  },
  {
    "property": "zen-fluent.enhanced.tab-archive.keep",
    "label": "Keep archived tabs",
    "type": "dropdown",
    "defaultValue": "90",
    "placeholder": false,
    "options": [
      { "label": "7 days", "value": "7" },
      { "label": "30 days", "value": "30" },
      { "label": "90 days", "value": "90" },
      { "label": "1 year", "value": "365" },
      { "label": "Forever", "value": "forever" }
    ]
  },
  {
    "property": "zen-fluent.enhanced.tab-archive.pinned",
    "label": "Archive pinned tabs too",
    "type": "checkbox",
    "defaultValue": false
  },
  {
    "property": "zen-fluent.enhanced.tab-archive.folders",
    "label": "Archive tabs in folders too",
    "type": "checkbox",
    "defaultValue": false
  },
  {
    "property": "zen-fluent.enhanced.pdf-viewer",
    "label": "PDF viewer ~Firefox's PDF toolbar, sidebar and menus in Fluent colors~",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "zen-fluent.enhanced.web-controls",
    "label": "Fluent controls on websites ~buttons and text fields a site leaves unstyled~",
    "type": "checkbox",
    "defaultValue": false
  },
  {
    "property": "zen-fluent.enhanced.browsing-stats",
    "label": "Browsing stats ~time on pages, visits and sites, read from your history from now on~",
    "type": "checkbox",
    "defaultValue": false
  }
